// Gacha Hub — data model (Postgres; a SQLite variant is generated for local dev).
// Game structure lives in code (packages/shared/src/games). These tables hold
// users, their per-game profiles, and tracked data. Catalog entities
// (characters, weapons, materials) are JSON in the shared package and are
// referenced here by their catalog ids.

generator client {
  provider      = "prisma-client-js"
  // "native" for local machines; rhel target for Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon/Supabase pooler) for serverless functions…
  url       = env("DATABASE_URL")
  // …and a direct connection for migrations.
  directUrl = env("DIRECT_DATABASE_URL")
}

/// A person, created on first Discord OAuth sign-in.
model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  username  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  gameInstances GameInstance[]
  tasks         Task[]
  reminderRules ReminderRule[]
  auditLogs     AuditLog[]
}

/// Server-side session backing the signed cookie.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A user's profile for one game — exactly one per user per game.
/// `gameKey` references a hardcoded module; `regionKey` picks reset timing.
model GameInstance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameKey   String
  regionKey String   @default("eu")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currencies    CurrencyState[]
  characters    Character[]
  ownerships    Ownership[]
  materials     MaterialStock[]
  reminderRules ReminderRule[]

  @@unique([userId, gameKey])
  @@index([userId])
}

/// Current value of one currency for one profile.
model CurrencyState {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  key            String
  value          Float        @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([gameInstanceId, key])
}

/// A tracked character build. `catalogId` links to the game's catalog entry
/// (optional until catalogs ship). `doc` is the game's bespoke build document;
/// `docVersion` lets per-game migrations upgrade old documents on read.
model Character {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  catalogId      String?
  name           String
  portraitUrl    String?
  doc            Json
  docVersion     Int          @default(1)
  buildStatus    String       @default("none") // none | building | good | perfect
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([gameInstanceId])
  @@index([gameInstanceId, catalogId])
}

/// Which catalog entries (characters / weapons / items) a profile owns.
model Ownership {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  kind           String // character | weapon | item
  catalogId      String
  qty            Int          @default(1)
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([gameInstanceId, kind, catalogId])
}

/// How many of each catalog material a profile currently holds.
model MaterialStock {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([gameInstanceId, materialId])
}

/// A user-created (or generated) task: recurring daily/weekly, farming goal,
/// or checklist. `scope`/`refId` attach it to a profile or a character.
/// Generated farming tasks carry `materialId` + `origin` for grouping/merging.
model Task {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope           String // game | character
  refId           String
  type            String // recurring | goal | checklist
  title           String
  cadence         String? // daily | weekly
  regionAware     Boolean   @default(false)
  target          Float?
  progress        Float     @default(0)
  items           Json? // ChecklistItem[]
  materialId      String?
  origin          Json? // TaskOrigin
  priority        String    @default("normal") // low | normal | high
  backlog         Boolean   @default(false) // hidden completionist backlog goal
  notify          Boolean   @default(false) // include in the Discord digest
  lastCompletedAt DateTime?
  reminder        Json? // ReminderConfig
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Nesting: a farming goal parent (e.g. "Farm Venti") holds material subtasks.
  parentId String?
  parent   Task?   @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[]  @relation("TaskChildren")

  reminderRules ReminderRule[]

  @@index([userId])
  @@index([scope, refId])
  @@index([userId, materialId])
  @@index([parentId])
}

/// A reminder the cron tick evaluates: a profile's daily reset
/// (gameInstanceId set) or a specific task's due window (taskId set).
model ReminderRule {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameInstanceId String?
  gameInstance   GameInstance? @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  config         Json // ReminderConfig
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())

  logs ReminderLog[]

  @@index([userId])
  @@index([gameInstanceId])
}

/// Idempotency log: one row per (rule, reset boundary) so coarse or repeated
/// cron ticks never send the same reminder twice.
model ReminderLog {
  id        String       @id @default(cuid())
  ruleId    String
  rule      ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  firedFor  DateTime
  createdAt DateTime     @default(now())

  @@unique([ruleId, firedFor])
  @@index([ruleId])
}

/// Time-boxed gacha banner, global per game, uploaded by an admin.
model Banner {
  id        String   @id @default(cuid())
  gameKey   String
  key       String
  name      String
  kind      String // character | weapon | other
  startsAt  DateTime
  endsAt    DateTime
  featured  Json // BannerFeatured[]
  payload   Json?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameKey, key])
  @@index([gameKey, endsAt])
}

/// Time-boxed in-game event, global per game, uploaded by an admin.
model Event {
  id          String   @id @default(cuid())
  gameKey     String
  key         String
  name        String
  startsAt    DateTime
  endsAt      DateTime
  description String?
  rewards     Json?
  url         String?
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([gameKey, key])
  @@index([gameKey, endsAt])
}

/// Who changed what via admin uploads.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  targetKind  String
  targetKey   String
  diff        Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
}
