// Gacha Hub — data model (Postgres; a SQLite variant is generated for local dev).
// Game structure lives in code (packages/shared/src/games). These tables hold
// users, their per-game profiles, and tracked data. Catalog entities
// (characters, weapons, materials) are JSON in the shared package and are
// referenced here by their catalog ids.

generator client {
  provider     = "prisma-client"
  // TypeScript, bundled with the server; the connection comes from a driver
  // adapter (apps/server/src/lib/prisma.ts) and the URLs from prisma.config.ts.
  output       = "../apps/server/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A person, created on first Discord OAuth sign-in.
model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  username  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  gameInstances GameInstance[]
  tasks         Task[]
  reminderRules ReminderRule[]
  auditLogs     AuditLog[]
  effects       EffectApplication[]
  links         LinkedAccount[]
  importRuns    ImportRun[]
}

/// Server-side session backing the signed cookie.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A user's profile for one game — exactly one per user per game.
/// `gameKey` references a hardcoded module; `regionKey` picks reset timing.
model GameInstance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameKey   String
  regionKey String   @default("eu")
  /// Asleep = hidden from Home and skipped by reminders, without uninstalling.
  sleeping  Boolean  @default(false)
  /// The in-game UID and account level (Adventure Rank, Trailblaze Level…), typed or synced.
  uid          String?
  accountLevel Int?
  /// The world level (World Level, Equilibrium Level, SOL3 Phase) where the game has one.
  worldLevel   Int?
  /// Place in the user's top strip (the library's drag to reorder); new games go last.
  position     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currencies    CurrencyState[]
  characters    Character[]
  ownerships    Ownership[]
  materials     MaterialStock[]
  reminderRules ReminderRule[]
  teams         Team[]
  gearPieces    GearPiece[]
  pullEntries   PullEntry[]
  cycleResults  CycleResult[]
  passStates    PassState[]
  dayRecords    DayRecord[]
  wishlist      WishlistItem[]
  importRuns    ImportRun[]

  @@unique([userId, gameKey])
  @@index([userId])
}

/// One logged run of pulls on a banner type; when `fiveStar`, its last pull was
/// a 5★ (a zero-count 5★ is a calibration marker). Pity is derived (ADR 0002).
model PullEntry {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  /// A `pullBanners` key of the game module (character, weapon, standard…).
  bannerKey      String
  count          Int
  fiveStar       Boolean      @default(false)
  featured       Boolean?
  catalogId      String?
  createdAt      DateTime     @default(now())

  @@index([gameInstanceId, bannerKey, createdAt])
}

/// One endgame mode's result for one cycle (a manifest `endgame` key). `source`
/// is manual or auto (ADR 0005); editing an auto row makes it manual.
model CycleResult {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  modeKey        String
  /// The cycle window's start instant.
  cycleStart     DateTime
  /// The mode's metric (stars, acts…) and a sub-metric such as "floor 12".
  result         Int?
  detail         String?
  /// Premium currency earned this cycle.
  premium        Int?
  /// Teams used: lists of character catalog ids.
  teams          Json?
  source         String       @default("manual")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([gameInstanceId, modeKey, cycleStart])
}

/// A profile's battle pass (`battle`) or 30-day pass (`monthly`).
model PassState {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  kind           String
  level          Int?
  weeklyXp       Int?
  /// When a 30-day pass runs out; a battle pass ends with the version.
  endsAt         DateTime?
  source         String       @default("manual")
  updatedAt      DateTime     @updatedAt

  @@unique([gameInstanceId, kind])
}

/// A profile's game day (server-local date, YYYY-MM-DD), written on every
/// change: the Home heatmap and streaks, the open-goals line and pulls gained.
model DayRecord {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  day            String
  dailiesDone    Int          @default(0)
  dailiesTotal   Int          @default(0)
  goalsOpen      Int          @default(0)
  /// Pulls on hand at the day's last change (premium currency and tickets).
  pulls          Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([gameInstanceId, day])
}

/// A gear piece in the bag (Genshin artifact, HSR relic…). Equipped pieces live
/// in their build's doc instead; equipping moves a piece between the two, so
/// each piece exists in exactly one place.
model GearPiece {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  setName        String       @default("")
  slot           String
  level          Int          @default(0)
  mainStat       String       @default("")
  substats       Json // StatRow[]
  createdAt      DateTime     @default(now())

  @@index([gameInstanceId])
}

/// A saved team / party preset for one profile (members are catalog ids).
model Team {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  name           String
  members        Json // string[] of character catalog ids
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([gameInstanceId])
}

/// Current value of one currency for one profile.
model CurrencyState {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  key            String
  value          Float        @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([gameInstanceId, key])
}

/// A tracked character build. `catalogId` links to the game's catalog entry
/// (optional until catalogs ship). `doc` is the game's bespoke build document;
/// `docVersion` lets per-game migrations upgrade old documents on read.
model Character {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  catalogId      String?
  name           String
  portraitUrl    String?
  doc            Json
  docVersion     Int          @default(1)
  buildStatus    String       @default("none") // none | building | good | perfect
  /// The build's role, one of the game's KPI roles (WIREFRAMES.md G4); null reads as the game's first.
  role           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([gameInstanceId])
  @@index([gameInstanceId, catalogId])
}

/// Which catalog entries (characters / weapons / items) a profile owns.
model Ownership {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  kind           String // character | weapon | item
  catalogId      String
  qty            Int          @default(1)
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([gameInstanceId, kind, catalogId])
}

/// How many of each catalog material a profile currently holds.
model MaterialStock {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  materialId     String
  qty            Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([gameInstanceId, materialId])
}

/// A user-created (or generated) task: recurring daily/weekly, farming goal,
/// or checklist. `scope`/`refId` attach it to a profile or a character.
/// Generated farming tasks carry `materialId` + `origin` for grouping/merging.
model Task {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope           String // game | character
  refId           String
  type            String // recurring | goal | checklist
  title           String
  cadence         String? // daily | weekly | monthly | cycle | version
  /// The manifest entry a monthly or cycle task follows (a shop or endgame mode key).
  anchorKey       String?
  regionAware     Boolean   @default(false)
  target          Float?
  progress        Float     @default(0)
  items           Json? // ChecklistItem[]
  materialId      String?
  origin          Json? // TaskOrigin
  priority        String    @default("normal") // low | normal | high
  backlog         Boolean   @default(false) // hidden completionist backlog goal
  notify          Boolean   @default(false) // include in the Discord digest
  lastCompletedAt DateTime?
  reminder        Json? // ReminderConfig
  /// An event goal (ADR 0008): ticking it applies the event's effects, with `choice` picking an option.
  eventId         String?
  choice          Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Nesting: a farming goal parent (e.g. "Farm Venti") holds material subtasks.
  parentId String?
  parent   Task?   @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[]  @relation("TaskChildren")

  reminderRules ReminderRule[]

  @@index([userId])
  @@index([scope, refId])
  @@index([userId, materialId])
  @@index([parentId])
}

/// A reminder the cron tick evaluates: a profile's daily reset
/// (gameInstanceId set) or a specific task's due window (taskId set).
model ReminderRule {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameInstanceId String?
  gameInstance   GameInstance? @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  config         Json // ReminderConfig
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())

  logs ReminderLog[]

  @@index([userId])
  @@index([gameInstanceId])
}

/// Idempotency log: one row per (rule, reset boundary) so coarse or repeated
/// cron ticks never send the same reminder twice.
model ReminderLog {
  id        String       @id @default(cuid())
  ruleId    String
  rule      ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  firedFor  DateTime
  /// What fired: "" for reset and check-in reminders, "stamina", "endgame:<mode>".
  key       String       @default("")
  createdAt DateTime     @default(now())

  @@unique([ruleId, firedFor, key])
  @@index([ruleId])
}

/// Time-boxed gacha banner, global per game, uploaded by an admin.
model Banner {
  id        String   @id @default(cuid())
  gameKey   String
  key       String
  name      String
  kind      String // character | weapon | other
  startsAt  DateTime
  endsAt    DateTime
  featured  Json // BannerFeatured[]
  payload   Json?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameKey, key])
  @@index([gameKey, endsAt])
}

/// Time-boxed in-game event, global per game, uploaded by an admin.
model Event {
  id          String   @id @default(cuid())
  gameKey     String
  key         String
  name        String
  startsAt    DateTime
  endsAt      DateTime
  description String?
  rewards     Json?
  /// Effect[] (packages/shared/src/effects.ts, ADR 0008).
  effects     Json?
  url         String?
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications EffectApplication[]

  @@unique([gameKey, key])
  @@index([gameKey, endsAt])
}

/// One applied event effect (ADR 0008): applied once per user, event and effect key; `undo` reverses it.
model EffectApplication {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key            String
  gameInstanceId String
  undo           Json?
  createdAt      DateTime @default(now())

  @@unique([userId, eventId, key])
}

/// Who changed what via admin uploads.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  targetKind  String
  targetKey   String
  diff        Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
}

/// A unit the user wants (WIREFRAMES.md G4): shown on Characters, in the savings planner and the calendar.
model WishlistItem {
  id             String       @id @default(cuid())
  gameInstanceId String
  gameInstance   GameInstance @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  kind           String // character | weapon
  catalogId      String
  createdAt      DateTime     @default(now())

  @@unique([gameInstanceId, kind, catalogId])
}

/// A user's link to a game-account provider (ADR 0005): read-only, opt-in,
/// revoked by deleting the row. The secret never leaves the server.
model LinkedAccount {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// hoyolab, enka, skport…
  provider   String
  /// The account at the provider: the HoYoLAB account id, or a game UID.
  accountId  String
  /// AES-256-GCM "iv.tag.data" (lib/linkSecret.ts), sealed for "userId:provider"; null where nothing is secret.
  secret     String?
  keyVersion Int?
  /// ok, or attention after a failed sync (no retries until linked again).
  status     String    @default("ok")
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, provider, accountId])
  @@index([userId])
}

/// One import or sync and what it did (ADR 0005); a failed one keeps its error.
model ImportRun {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameInstanceId String?
  gameInstance   GameInstance? @relation(fields: [gameInstanceId], references: [id], onDelete: Cascade)
  /// uigf, history-link, hoyolab, enka…
  provider       String
  /// pulls, notes, chronicle, showcase
  kind           String
  added          Int           @default(0)
  skipped        Int           @default(0)
  error          String?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}
