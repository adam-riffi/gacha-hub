{
  "name": "gacha-hub",
  "private": true,
  "version": "0.2.0",
  "description": "Cross-game gacha tracker with hardcoded per-game modules, a Discord bot, and reset reminders. Serverless-ready (Vercel).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @gacha/server",
    "dev:web": "npm run dev -w @gacha/web",
    "build": "npm run build -w @gacha/web && npm run build:server",
    "build:server": "node scripts/build-server-bundle.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "npm run start -w @gacha/server",
    "test": "npm run test -w @gacha/server",
    "typecheck": "npm run typecheck -w @gacha/shared && npm run typecheck -w @gacha/server && npm run typecheck -w @gacha/web",
    "check": "npm run prisma:generate && npm run lint && npm run typecheck && npm test && npm run prisma:generate && npm run build && npm run budget && npm run e2e",
    "budget": "node scripts/budget.mjs",
    "e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "harness": "npm run build:server && node scripts/harness/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:install": "npm --prefix scripts/catalog install",
    "catalog:genshin": "npm --prefix scripts/catalog run genshin",
    "catalog:hsr": "npm --prefix scripts/catalog run hsr",
    "catalog:wuwa": "npm --prefix scripts/catalog run wuwa",
    "catalog:endfield": "npm --prefix scripts/catalog run endfield",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:sqlite": "node scripts/gen-sqlite-schema.mjs && prisma db push --schema prisma/schema.sqlite.prisma && prisma generate --schema prisma/schema.sqlite.prisma",
    "setup:sqlite": "npm run db:sqlite",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20"
  }
}
