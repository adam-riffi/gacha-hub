# ---- Database ----
# Local dev (default): SQLite, no server needed. Run `npm run setup:sqlite` once.
DATABASE_URL="file:./dev.db"
# Production (Vercel): a POOLED Postgres URL (Neon / Supabase pooler) …
# DATABASE_URL="postgresql://user:pass@host-pooler/db?sslmode=require&pgbouncer=true"
# … plus a DIRECT (non-pooled) URL used only for migrations.
# DIRECT_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Local Postgres via docker-compose instead: `npm run db:up`
# DATABASE_URL="postgresql://gacha:gacha@localhost:5432/gacha?schema=public"
# DIRECT_DATABASE_URL="postgresql://gacha:gacha@localhost:5432/gacha?schema=public"

# ---- Server ----
PORT=3000
# Public base URL of the app (OAuth redirect + links). No trailing slash.
APP_BASE_URL="http://localhost:5173"
# Long random string used to sign session cookies.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# "true" behind HTTPS in production so cookies are Secure.
COOKIE_SECURE="false"
# Dev-only shortcut login (never enabled in production builds).
DEV_LOGIN_ENABLED="true"

# ---- Admin ----
# Comma-separated Discord user ids allowed to upload banners/events/catalog patches.
ADMIN_DISCORD_IDS=""

# ---- Discord OAuth (web sign-in) ----
# https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Must exactly match a redirect added in the Discord app's OAuth2 settings.
DISCORD_OAUTH_REDIRECT="http://localhost:5173/api/auth/discord/callback"

# ---- Discord bot (slash commands over HTTP Interactions + DMs via REST) ----
DISCORD_BOT_TOKEN=""
DISCORD_APP_ID=""
# "Public Key" from the app's General Information page — verifies interactions.
DISCORD_PUBLIC_KEY=""
# Set the app's "Interactions Endpoint URL" to ${APP_BASE_URL}/api/discord/interactions
# Optional: register commands instantly to one guild during dev.
DISCORD_DEV_GUILD_ID=""

# ---- Scheduler ----
# Shared secret the external cron (GitHub Actions workflow) sends to /api/cron/tick.
CRON_SECRET=""
# Run the minute tick in-process instead (only for always-on hosts like Docker).
ENABLE_INPROCESS_CRON="false"

# ---- Uploads ----
# Vercel Blob token: when set, uploads go to Blob (serverless has no disk).
BLOB_READ_WRITE_TOKEN=""
# Local fallback directory (always-on server only).
UPLOAD_DIR="./uploads"

# ---- Web (Vite) ----
# Leave empty to use same-origin (dev proxy / prod).
VITE_API_BASE_URL=""
