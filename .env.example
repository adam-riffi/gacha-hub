# ---- Database ----
# Local dev uses the docker-compose Postgres (npm run db:up)
DATABASE_URL="postgresql://gacha:gacha@localhost:5432/gacha?schema=public"

# ---- Server ----
PORT=3000
# Public base URL of the app (used for OAuth redirect + links). No trailing slash.
APP_BASE_URL="http://localhost:3000"
# Long random string used to sign session cookies.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# In production behind HTTPS set to "true" so cookies are Secure.
COOKIE_SECURE="false"

# ---- Discord OAuth (web sign-in) ----
# From https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Must exactly match a redirect added in the Discord app's OAuth2 settings:
#   ${APP_BASE_URL}/api/auth/discord/callback
DISCORD_OAUTH_REDIRECT="http://localhost:3000/api/auth/discord/callback"

# ---- Discord Bot (two-way commands + reminders) ----
# Bot token from the same Discord application -> Bot
DISCORD_BOT_TOKEN=""
# Application (client) id again, used to register slash commands.
DISCORD_APP_ID=""
# Optional: register commands instantly to one guild during dev (else global, slow to propagate).
DISCORD_DEV_GUILD_ID=""

# ---- Uploads ----
# Where uploaded portraits/icons are stored (mounted to a persistent volume in prod).
UPLOAD_DIR="./uploads"

# ---- Web (Vite) ----
# Base URL the browser uses to reach the API. Leave empty to use same-origin (prod).
VITE_API_BASE_URL="http://localhost:3000"
